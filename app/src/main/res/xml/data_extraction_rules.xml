<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer scope; an allow-list, same reasoning as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="eq_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="eq_settings.xml" />
    </device-transfer>
</data-extraction-rules>
