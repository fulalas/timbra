<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pa_row_pressed">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="90"
                android:startColor="#101010"
                android:endColor="#242424" />
            <stroke android:width="1dp" android:color="@color/pa_accent_dim" />
        </shape>
    </item>
    <!-- Without a mask the ripple is clipped to the drawable's RECTANGULAR bounds and spills
         past the 6dp corners below. row_bg.xml does the same thing. -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
