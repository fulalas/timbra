<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Deck window: clips the pager to the art region so a card-flip glide (translationY)
         slides WITHIN this area and never draws over the transport controls below. -->
    <FrameLayout
        android:id="@+id/deck_window"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/art_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <include
        android:id="@+id/controls"
        layout="@layout/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
